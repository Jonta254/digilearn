# ── Safaricom Daraja (M-Pesa) ────────────────────────────────────────────────
# Course paywalls stay in an honest "not configured" state until these are set.
# Get sandbox credentials from https://developer.safaricom.co.ke (create an app).
# Set the same keys in your Vercel project (Settings → Environment Variables).

# "sandbox" (default) or "production"
MPESA_ENV=sandbox

# App Consumer Key / Secret from the Daraja portal
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Lipa Na M-Pesa Online (STK Push) — Business Short Code and Passkey.
# Sandbox test shortcode is 174379 with the sandbox passkey from the portal.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=

# PayBill → CustomerPayBillOnline (default). Till/Buy Goods → CustomerBuyGoodsOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Optional: override the STK callback URL. If unset, it's derived from the
# request host as https://<your-domain>/api/mpesa/callback.
# MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
